# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (async SQLAlchemy URL)
# Docker Compose service hostname is `db`.
DATABASE_URL=postgresql+asyncpg://jobalert:jobalert@db:5432/jobalert
POSTGRES_PASSWORD=jobalert

# Polling
POLL_INTERVAL_SECONDS=600
COMPANY_CONCURRENCY=8
MISS_THRESHOLD=2

# HTTP client used for ATS + Telegram
HTTP_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=JobSearchAlert/1.0 (self-hosted job monitor)

# Matching + company seed files (paths inside the container/repo)
MATCHING_CONFIG_PATH=config/matching.yaml
COMPANIES_CONFIG_PATH=config/companies.yaml

# Telegram — leave disabled until a bot is configured.
# When NOTIFICATIONS_ENABLED=true, both token and chat id are required.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io — optional heartbeat / dead-man's switch. Leave empty to disable.
# Create a Simple check with Period = POLL_INTERVAL_SECONDS (default 10 minutes)
# and Grace = 10 minutes. Configure Telegram notifications in Healthchecks.io itself.
# Do not commit the real ping URL; the app never logs it.
HEALTHCHECKS_PING_URL=
